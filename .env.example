# Database password (required)
DB_PASSWORD=your-secure-database-password-here

# JWT secret for authentication (required)
JWT_SECRET=your-secure-jwt-secret-here

# CORS origin (optional, defaults to https://focusshield.app)
CORS_ORIGIN=https://focusshield.app

# Brevo (welcome email on register). Without it, sends are skipped
# (logged, not raised) so registration still succeeds.
BREVO_API_KEY=
FROM_EMAIL=hello@focusshield.app
FROM_NAME=FocusShield

# Google Search Console read-only service account (add as a restricted user in the site's GSC property too)
GSC_SERVICE_ACCOUNT_EMAIL=gsc-readonly@digital-marketing-501501.iam.gserviceaccount.com
